{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "overlays",
  "type": "registry:item",
  "title": "Fleek UI overlays snippets",
  "description": "Overlays — Alpine dropdown, modal, tooltip (x-data blocks)",
  "registryDependencies": [
    "https://raw.githubusercontent.com/fleekdash/fleek-ui/main/registry/fleek-ui.json"
  ],
  "files": [
    {
      "path": "snippets/overlays.html",
      "content": "<!-- Fleek UI snippets: Alpine overlay patterns (Pines-style x-data).\n     Surfaces use popover/card tokens so they track theme + dark mode.\n     x-cloak hides them until Alpine boots; x-transition for entrances. -->\n\n<!-- Dropdown menu -->\n<div class=\"relative\" x-data=\"{ open: false }\">\n  <button\n    type=\"button\"\n    class=\"fui-btn fui-btn-outline\"\n    x-on:click=\"open = !open\"\n    x-bind:aria-expanded=\"open\"\n    aria-haspopup=\"true\">\n    Actions\n  </button>\n  <div\n    class=\"border-border bg-popover text-popover-foreground absolute right-0 z-50 mt-1 w-44 rounded-md border p-1 shadow-md\"\n    role=\"menu\"\n    x-show=\"open\"\n    x-cloak\n    x-transition.opacity.scale.90\n    x-on:click.outside=\"open = false\"\n    x-on:keydown.escape.window=\"open = false\">\n    <button\n      type=\"button\"\n      class=\"hover:bg-muted flex w-full items-center rounded-sm px-2 py-1.5 text-sm\"\n      role=\"menuitem\"\n      x-on:click=\"open = false\">\n      Rename\n    </button>\n    <button\n      type=\"button\"\n      class=\"hover:bg-muted flex w-full items-center rounded-sm px-2 py-1.5 text-sm\"\n      role=\"menuitem\"\n      x-on:click=\"open = false\">\n      Duplicate\n    </button>\n    <div class=\"border-border my-1 border-t\" role=\"separator\"></div>\n    <button\n      type=\"button\"\n      class=\"text-destructive hover:bg-destructive/10 flex w-full items-center rounded-sm px-2 py-1.5 text-sm\"\n      role=\"menuitem\"\n      x-on:click=\"open = false\">\n      Delete\n    </button>\n  </div>\n</div>\n\n<!-- Modal: fixed overlay + centered card; body scroll is the host's\n     concern inside an iframe - keep the surface itself scrollable. -->\n<div x-data=\"{ open: false }\">\n  <button\n    type=\"button\"\n    class=\"fui-btn fui-btn-primary\"\n    x-on:click=\"open = true\">\n    Open dialog\n  </button>\n  <template x-teleport=\"body\">\n    <div\n      class=\"bg-background-alpha-50 fixed inset-0 z-50 flex items-center justify-center p-4 backdrop-blur-sm\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      x-show=\"open\"\n      x-cloak\n      x-transition.opacity\n      x-on:keydown.escape.window=\"open = false\">\n      <div\n        class=\"fui-card w-full max-w-md\"\n        x-transition.opacity.scale.95\n        x-on:click.outside=\"open = false\">\n        <div class=\"fui-card-header flex items-center justify-between\">\n          <span>Confirm</span>\n          <button\n            type=\"button\"\n            class=\"fui-btn fui-btn-ghost h-7 w-7 p-0\"\n            aria-label=\"Close\"\n            x-on:click=\"open = false\">\n            &times;\n          </button>\n        </div>\n        <div class=\"fui-card-body text-muted-foreground text-sm\">\n          This action cannot be undone.\n        </div>\n        <div class=\"fui-card-footer flex items-center justify-end gap-2\">\n          <button\n            type=\"button\"\n            class=\"fui-btn fui-btn-outline\"\n            x-on:click=\"open = false\">\n            Cancel\n          </button>\n          <button\n            type=\"button\"\n            class=\"fui-btn fui-btn-destructive\"\n            x-on:click=\"open = false\">\n            Delete\n          </button>\n        </div>\n      </div>\n    </div>\n  </template>\n</div>\n\n<!-- Tabs -->\n<div x-data=\"{ tab: 'general' }\">\n  <div class=\"border-border flex gap-1 border-b\" role=\"tablist\">\n    <button\n      type=\"button\"\n      class=\"rounded-t-md px-3 py-1.5 text-sm font-medium\"\n      role=\"tab\"\n      x-bind:class=\"tab === 'general' ? 'bg-card text-foreground border border-border border-b-0 -mb-px' : 'text-muted-foreground hover:text-foreground'\"\n      x-bind:aria-selected=\"tab === 'general'\"\n      x-on:click=\"tab = 'general'\">\n      General\n    </button>\n    <button\n      type=\"button\"\n      class=\"rounded-t-md px-3 py-1.5 text-sm font-medium\"\n      role=\"tab\"\n      x-bind:class=\"tab === 'advanced' ? 'bg-card text-foreground border border-border border-b-0 -mb-px' : 'text-muted-foreground hover:text-foreground'\"\n      x-bind:aria-selected=\"tab === 'advanced'\"\n      x-on:click=\"tab = 'advanced'\">\n      Advanced\n    </button>\n  </div>\n  <div class=\"fui-card rounded-t-none p-4\" role=\"tabpanel\">\n    <p class=\"text-sm\" x-show=\"tab === 'general'\">General settings.</p>\n    <p class=\"text-sm\" x-show=\"tab === 'advanced'\" x-cloak>\n      Advanced settings.\n    </p>\n  </div>\n</div>\n\n<!-- Tooltip (hover, no focus trap needed) -->\n<span class=\"relative inline-block\" x-data=\"{ show: false }\">\n  <button\n    type=\"button\"\n    class=\"fui-btn fui-btn-ghost fui-btn-sm\"\n    x-on:mouseenter=\"show = true\"\n    x-on:mouseleave=\"show = false\"\n    x-on:focus=\"show = true\"\n    x-on:blur=\"show = false\">\n    ?\n  </button>\n  <span\n    class=\"bg-foreground text-background absolute bottom-full left-1/2 z-50 mb-1 -translate-x-1/2 rounded-sm px-2 py-1 text-xs whitespace-nowrap\"\n    role=\"tooltip\"\n    x-show=\"show\"\n    x-cloak\n    x-transition.opacity\n    >Helpful hint</span\n  >\n</span>\n",
      "type": "registry:file",
      "target": "fleek-ui/snippets/overlays.html"
    }
  ]
}
